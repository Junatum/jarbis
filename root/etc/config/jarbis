# Disabled until the user enables Jarbis. No WAN firewall changes.
config core 'main'
    option enabled '0'
    option api_version '1'

# Local managed Mosquitto is provisioned when the service starts.
# Use external mode for any existing broker to avoid overwriting settings.
config mqtt 'broker'
    option mode 'managed'
    option host '127.0.0.1'
    option port '1883'
    option managed_ready '0'

config discovery 'discovery'
    option enabled '1'

