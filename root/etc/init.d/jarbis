#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
START=81
STOP=19
USE_PROCD=1

BROKER_BIN="${JARBIS_BROKER_BIN:-/usr/libexec/jarbis-broker}"
UCI_BIN="${JARBIS_UCI_BIN:-uci}"

get() { "$UCI_BIN" -q get "$1" 2>/dev/null || :; }

# The MQTT reader is needed only for at least one enabled Shelly sensor.
# Do not count disabled devices or devices that merely have a protocol option.
has_active_sensor() {
    for id in $("$UCI_BIN" -q show jarbis 2>/dev/null |
        sed -n 's/^jarbis\.\([A-Za-z_][A-Za-z0-9_]*\)=device$/\1/p'); do
        [ "$(get "jarbis.$id.enabled")" = 1 ] || continue
        [ "$(get "jarbis.$id.kind")" = sensor ] || continue
        [ "$(get "jarbis.$id.protocol")" = shelly_htg3 ] || continue
        return 0
    done
    return 1
}

start_service() {
    [ "$(get jarbis.main.enabled)" = 1 ] || return 0
    if [ "$(get jarbis.broker.mode)" = managed ]; then
        "$BROKER_BIN" check >/dev/null 2>&1 ||
            "$BROKER_BIN" start || return 1
    fi
    # Only a paired sensor needs the additional subscriber. Lights keep the
    # original broker-only service footprint.
    if has_active_sensor; then
        procd_open_instance shelly
        procd_set_param command /usr/libexec/jarbis-shelly-listen
        procd_set_param respawn 3600 5 5
        procd_close_instance
    fi
}

stop_service() {
    # Preserve the original managed broker ownership check. Never touch a
    # shared/external broker when this procd service is stopped.
    "$BROKER_BIN" stop
}
