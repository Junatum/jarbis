#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# Only active when explicitly enabled. Mosquitto owns its own procd process.
START=81
STOP=19
start() {
    [ "$(uci -q get jarbis.main.enabled 2>/dev/null)" = 1 ] || return 0
    [ "$(uci -q get jarbis.broker.mode 2>/dev/null)" = managed ] || return 0
    /usr/libexec/jarbis-broker start
}
stop() {
    # Stop only a provably exclusive managed Broker. External/shared Brokers
    # are never changed, and all credentials are preserved for reinstall.
    /usr/libexec/jarbis-broker stop
}
