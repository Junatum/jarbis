#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
START=81
STOP=19
USE_PROCD=1

start_service() {
    [ "$(uci -q get jarbis.main.enabled 2>/dev/null)" = 1 ] || return 0
    if [ "$(uci -q get jarbis.broker.mode 2>/dev/null)" = managed ]; then
        /usr/libexec/jarbis-broker check >/dev/null 2>&1 ||
            /usr/libexec/jarbis-broker start || return 1
    fi
    # Only a paired sensor needs the additional subscriber. Lights keep the
    # original broker-only service footprint.
    if uci -q show jarbis 2>/dev/null | grep -q 'protocol=.shelly_htg3'; then
        procd_open_instance shelly
        procd_set_param command /usr/libexec/jarbis-shelly-listen
        procd_set_param respawn 3600 5 5
        procd_close_instance
    fi
}

stop_service() {
    # Preserve the original managed broker ownership check. Never touch a
    # shared/external broker when this procd service is stopped.
    /usr/libexec/jarbis-broker stop
}
