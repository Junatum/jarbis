{
  "jarbis": {
    "description": "Grant authenticated users access to the Jarbis home automation API",
    "read": {
      "ubus": {
        "jarbis": [
          "status",
          "devices_list",
          "discovery_list"
        ]
      }
    },
    "write": {
      "ubus": {
        "jarbis": [
          "light_set",
          "discovery_scan",
          "settings_update",
          "device_add",
          "device_update",
          "device_remove",
          "broker_credentials"
        ]
      }
    }
  }
}
