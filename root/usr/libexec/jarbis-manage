#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Restricted UCI mutations for explicitly approved local device pairing.
set -eu
umask 077
UCI_BIN="${JARBIS_UCI_BIN:-uci}"
BROKER_BIN="${JARBIS_BROKER_BIN:-/usr/libexec/jarbis-broker}"
CACHE="${JARBIS_DISCOVERY_CACHE:-/tmp/jarbis-discovery.records}"
INIT="${JARBIS_INIT_BIN:-/etc/init.d/jarbis}"
ERROR_FILE="${JARBIS_MANAGE_ERROR_FILE:-/tmp/jarbis-manage.error}"
# Only known, non-secret failure codes are persisted. Never store broker stderr.
record_error() {
    tmp="$(mktemp "${ERROR_FILE}.XXXXXX")" || return 0
    printf '%s\n' "$1" > "$tmp"
    mv -f "$tmp" "$ERROR_FILE"
}
broker_error_code() {
    case "$1" in
        *'LAN IPv4 unavailable'*|*'invalid LAN IPv4'*) printf 'LAN_UNAVAILABLE' ;;
        *'mosquitto user missing'*) printf 'MOSQUITTO_USER_MISSING' ;;
        *'mosquitto_passwd missing'*) printf 'PASSWORD_TOOL_MISSING' ;;
        *'existing file-based Mosquitto'*|*'existing UCI-managed Mosquitto'*|*'existing Mosquitto listener/bridge'*|*'custom per-listener auth'*|*'managed Mosquitto configuration changed'*) printf 'BROKER_CONFIG_CONFLICT' ;;
        *'existing credentials'*|*'managed credentials missing'*) printf 'BROKER_CREDENTIALS_CONFLICT' ;;
        *'password hashing failed'*|*'entropy unavailable'*) printf 'BROKER_CREDENTIALS_FAILED' ;;
        *'Mosquitto service failed'*) printf 'BROKER_SERVICE_FAILED' ;;
        *) printf 'BROKER_START_FAILED' ;;
    esac
}
fail() { printf 'jarbis-manage: %s\n' "$1" >&2; exit 1; }
get() { "$UCI_BIN" -q get "$1" 2>/dev/null || :; }
valid_id() { case "$1" in ''|[!a-zA-Z_]*|*[!a-zA-Z0-9_]*) return 1 ;; esac; [ "${#1}" -le 48 ]; }
valid_topic() { case "$1" in ''|*[!a-zA-Z0-9_-]*|[-_]*) return 1 ;; esac; [ "${#1}" -le 96 ]; }
valid_name() {
    [ "${#1}" -gt 0 ] && [ "${#1}" -le 48 ] &&
        [ "$(printf '%s' "$1" | LC_ALL=C tr -cd 'a-zA-Z0-9 _&-')" = "$1" ]
}
[ "$#" -gt 0 ] || fail 'missing action'
LOCK="${JARBIS_MANAGE_LOCK:-/tmp/jarbis-manage.lock}"
mkdir "$LOCK" 2>/dev/null || fail 'another operation is running'
trap 'rmdir "$LOCK"' EXIT HUP INT TERM
case "$1" in
    enabled)
        [ "$#" -eq 2 ] || fail 'invalid arguments'
        case "$2" in 0|1) ;; *) fail 'invalid enabled flag' ;; esac
        # Clear stale diagnostic data, including on successful disable.
        rm -f "$ERROR_FILE"
        if [ "$2" = 1 ]; then
            if [ "$(get jarbis.broker.mode)" = managed ]; then
                # stdout/stderr is never sent to the web UI. Keep a bounded,
                # private diagnostic buffer and map it to fixed error codes.
                errlog="$(mktemp /tmp/jarbis-broker.XXXXXX)" || fail 'temporary log unavailable'
                if "$BROKER_BIN" start > /dev/null 2> "$errlog"; then
                    rm -f "$errlog"
                else
                    detail="$(head -c 2048 "$errlog")"
                    rm -f "$errlog"
                    code="$(broker_error_code "$detail")"
                    record_error "$code"
                    fail "MQTT broker could not start ($code)"
                fi
            fi
        fi
        [ "$(get jarbis.main.enabled)" = "$2" ] || {
            "$UCI_BIN" set "jarbis.main.enabled=$2"
            "$UCI_BIN" commit jarbis
        }
        # procd starts/stops the Shelly MQTT reader on activation changes.
        if [ -x "$INIT" ]; then
            if [ "$2" = 1 ]; then "$INIT" start >/dev/null 2>&1 || :
            else "$INIT" stop >/dev/null 2>&1 || :; fi
        fi
        ;;
    device-add)
        [ "$#" -eq 4 ] || [ "$#" -eq 5 ] || fail 'invalid arguments'
        id="$2"; name="$3"; topic="$4"
        protocol="${5:-tasmota}"
        case "$protocol" in tasmota|shelly_htg3) ;; *) fail 'unsupported device protocol' ;; esac
        if [ "$protocol" = shelly_htg3 ]; then
            suffix="${topic#shellyhtg3-}"
            [ "$suffix" != "$topic" ] && [ "${#suffix}" -eq 12 ] || fail 'invalid Shelly topic'
            case "$suffix" in *[!a-fA-F0-9]*) fail 'invalid Shelly topic' ;; esac
        fi
        valid_id "$id" && valid_name "$name" && valid_topic "$topic" || fail 'invalid device'
        [ "$(get jarbis.main.enabled)" = 1 ] || fail 'Jarbis disabled'
        [ -z "$(get "jarbis.$id")" ] || fail 'device ID already registered'
        [ -f "$CACHE" ] && [ ! -L "$CACHE" ] || fail 'discovery cache missing'
        found=0
        while IFS='|' read -r source ip mac known title; do
            if [ "$known" = "$topic" ]; then
                case "$protocol:$source" in
                    tasmota:http|tasmota:mqtt|shelly_htg3:shelly-http|shelly_htg3:shelly-dhcp) found=1; break ;;
                esac
            fi
        done < "$CACHE"
        [ "$found" = 1 ] || fail 'topic not in discovery list'
        # Duplicate Topics must never control two different devices.
        for section in $("$UCI_BIN" -q show jarbis 2>/dev/null | sed -n 's/^jarbis\.\([A-Za-z_][A-Za-z0-9_]*\)=device$/\1/p'); do
            [ "$(get "jarbis.$section.topic")" != "$topic" ] || fail 'topic already registered'
        done
        "$UCI_BIN" set "jarbis.$id=device"
        "$UCI_BIN" set "jarbis.$id.enabled=1"
        "$UCI_BIN" set "jarbis.$id.name=$name"
        if [ "$protocol" = shelly_htg3 ]; then
            "$UCI_BIN" set "jarbis.$id.kind=sensor"
        else
            "$UCI_BIN" set "jarbis.$id.kind=light"
        fi
        "$UCI_BIN" set "jarbis.$id.protocol=$protocol"
        "$UCI_BIN" set "jarbis.$id.topic=$topic"
        "$UCI_BIN" commit jarbis
        # Re-enter the service only for Shelly registration. Broker check
        # avoids restarting working Tasmota connections.
        if [ "$protocol" = shelly_htg3 ] && [ -x "$INIT" ]; then
            "$INIT" start >/dev/null 2>&1 || :
        fi
        ;;
    device-update)
        [ "$#" -eq 4 ] || fail 'invalid arguments'
        id="$2"; name="$3"
        valid_id "$id" && valid_name "$name" || fail 'invalid device'
        case "$4" in 0|1) ;; *) fail 'invalid enabled flag' ;; esac
        [ "$(get "jarbis.$id")" = device ] || fail 'unknown device'
        "$UCI_BIN" set "jarbis.$id.name=$name"
        "$UCI_BIN" set "jarbis.$id.enabled=$4"
        "$UCI_BIN" commit jarbis
        ;;
    device-remove)
        [ "$#" -eq 2 ] || fail 'invalid arguments'
        valid_id "$2" || fail 'invalid ID'
        [ "$(get "jarbis.$2")" = device ] || fail 'unknown device'
        "$UCI_BIN" delete "jarbis.$2"
        "$UCI_BIN" commit jarbis
        ;;
    *) fail 'unsupported action' ;;
esac
