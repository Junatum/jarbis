#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Fail-closed, non-destructive managed Mosquitto provisioning for OpenWrt 25.12.
set -eu
umask 077
UCI_BIN="${JARBIS_UCI_BIN:-uci}"
INIT="${JARBIS_MOSQUITTO_INIT:-/etc/init.d/mosquitto}"
PASSWD_BIN="${JARBIS_MOSQUITTO_PASSWD_BIN:-mosquitto_passwd}"
SECRET_DIR="${JARBIS_SECRET_DIR:-/etc/jarbis}"
BROKER_PASS="${JARBIS_BROKER_PASS:-/etc/mosquitto/jarbis.passwd}"
MOSQUITTO_CONF="${JARBIS_MOSQUITTO_CONF:-/etc/mosquitto/mosquitto.conf}"
fail() { printf 'jarbis-broker: %s\n' "$1" >&2; exit 1; }
get() { "$UCI_BIN" -q get "$1" 2>/dev/null || :; }
[ "$#" -eq 1 ] || fail 'usage: jarbis-broker setup|start|status|check'
case "$1" in setup|start|status|check) action="$1" ;; *) fail 'invalid action' ;; esac
[ "$(get jarbis.broker.mode)" = managed ] || { [ "$action" = status ] && exit 0; fail 'broker is external'; }
[ "${JARBIS_TEST_MODE:-}" = 1 ] || [ "$SECRET_DIR" = /etc/jarbis ] || fail 'invalid secret directory'
[ "${JARBIS_TEST_MODE:-}" = 1 ] || [ "$BROKER_PASS" = /etc/mosquitto/jarbis.passwd ] || fail 'invalid password path'
if [ "$action" = check ]; then
    [ "$(get jarbis.main.enabled)" = 1 ] || fail 'Jarbis disabled'
    host="$(get jarbis.broker.host)"; port="$(get jarbis.broker.port)"
    case "$host" in ''|-*|*[!a-zA-Z0-9.:_-]*) fail 'invalid host' ;; esac
    case "$port" in ''|*[!0-9]*) fail 'invalid port' ;; esac
    [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || fail 'invalid port'
    if [ "$(get jarbis.broker.mode)" = managed ]; then
        [ "$(get jarbis.broker.managed_ready)" = 1 ] && [ -s "$SECRET_DIR/mosquitto_pub" ] || fail 'broker not ready'
    fi
    XDG_CONFIG_HOME="$SECRET_DIR" HOME="$SECRET_DIR" \
        mosquitto_pub -h "$host" -p "$port" -W 2 -q 0 -t 'jarbis/healthcheck' -m 'ready' >/dev/null 2>&1 || fail 'MQTT connection failed'
    exit 0
fi
if [ "$action" = status ]; then
    [ "$(get jarbis.broker.managed_ready)" = 1 ] && [ -s "$BROKER_PASS" ] && [ -s "$SECRET_DIR/device-credentials" ]
    exit $?
fi
[ -x "$INIT" ] || fail 'Mosquitto service not installed'
command -v "$PASSWD_BIN" >/dev/null 2>&1 || fail 'mosquitto_passwd missing (build mosquitto-ssl with CONFIG_MOSQUITTO_PASSWD=y)'
# Never modify an existing user-managed broker; ownership marker is explicit.
if [ "$(get jarbis.broker.managed_ready)" = 1 ]; then
    [ "$(get mosquitto.jarbis_local)" = listener ] && \
    [ "$(get mosquitto.jarbis_lan)" = listener ] && \
    [ "$(get mosquitto.mosquitto.password_file)" = "$BROKER_PASS" ] || fail 'managed Mosquitto configuration changed; refusing overwrite'
    [ -s "$BROKER_PASS" ] && [ -s "$SECRET_DIR/device-credentials" ] && \
    [ -s "$SECRET_DIR/mosquitto_pub" ] && [ -s "$SECRET_DIR/mosquitto_sub" ] || fail 'managed credentials missing'
else
    [ "$(get mosquitto.owrt.use_uci)" != 1 ] || fail 'existing UCI-managed Mosquitto; use external mode'
    [ "$(get mosquitto.mosquitto.per_listener_settings)" != 1 ] || fail 'custom per-listener auth; use external mode'
    # UCI migration must not discard an active file-based Mosquitto config.
    # Stock commented sample is safe; configured directives require external mode.
    if [ -f "$MOSQUITTO_CONF" ] &&
        grep -Eq '^[[:space:]]*[^#[:space:]]' "$MOSQUITTO_CONF"; then
        fail 'existing file-based Mosquitto config; use external mode'
    fi
    if "$UCI_BIN" -q show mosquitto 2>/dev/null | grep -Eq '=listener|=bridge'; then
        fail 'existing Mosquitto listener/bridge; use external mode'
    fi
fi
lan="$(get network.lan.ipaddr)"
# Only support simple IPv4 static LAN binding. Avoid WAN/0.0.0.0 listeners.
case "$lan" in ''|0.0.0.0|127.*|*[!0-9.]*|.*|*.) fail 'static LAN IPv4 required' ;; esac
oldifs="$IFS"; IFS=.; set -- $lan; IFS="$oldifs"
[ "$#" -eq 4 ] || fail 'invalid LAN IPv4'
for octet do
    [ -n "$octet" ] && [ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] 2>/dev/null || fail 'invalid LAN IPv4'
done
# Credentials are provisioned once. Never rotate or overwrite on upgrades.
if [ "$(get jarbis.broker.managed_ready)" != 1 ]; then
    id mosquitto >/dev/null 2>&1 || fail 'mosquitto user missing'
    [ ! -e "$BROKER_PASS" ] && [ ! -e "$SECRET_DIR/device-credentials" ] && [ ! -e "$SECRET_DIR/mosquitto_pub" ] && [ ! -e "$SECRET_DIR/mosquitto_sub" ] || fail 'existing credentials; refusing overwrite'
    mkdir -p "$SECRET_DIR"
    chmod 700 "$SECRET_DIR"
    secret="$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | sha256sum | cut -c 1-64)"
    [ "${#secret}" -eq 64 ] || fail 'entropy unavailable'
    temp="$(mktemp /tmp/jarbis-pass.XXXXXX)" || fail 'temporary file failure'
    trap 'rm -f "$temp"' EXIT HUP INT TERM
    printf '%s:%s\n' 'jarbis' "$secret" > "$temp"
    # -U hashes plaintext inside a private /tmp file; password never appears in argv.
    "$PASSWD_BIN" -U "$temp" >/dev/null 2>&1 || fail 'password hashing failed'
    [ -s "$temp" ] || fail 'empty hashed password file'
    mv "$temp" "$BROKER_PASS"
    trap - EXIT HUP INT TERM
    chown mosquitto "$BROKER_PASS" || fail 'mosquitto user missing'
    chmod 600 "$BROKER_PASS"
    printf '%s\n' '-u jarbis' "-P $secret" > "$SECRET_DIR/mosquitto_pub"
    cp "$SECRET_DIR/mosquitto_pub" "$SECRET_DIR/mosquitto_sub"
    printf '%s\n' 'username=jarbis' "password=$secret" > "$SECRET_DIR/device-credentials"
    chmod 600 "$SECRET_DIR/mosquitto_pub" "$SECRET_DIR/mosquitto_sub" "$SECRET_DIR/device-credentials"
fi
# Avoid writes to the router overlay on every boot or repeat service start.
# A setup is idempotent once the original managed broker has been provisioned.
changed=0
set_if_changed() {
    key="$1"; expected="$2"
    [ "$(get "$key")" = "$expected" ] && return 0
    "$UCI_BIN" set "$key=$expected"
    changed=1
}
set_if_changed mosquitto.owrt.use_uci 1
set_if_changed mosquitto.mosquitto.allow_anonymous 0
set_if_changed mosquitto.mosquitto.password_file "$BROKER_PASS"
# Preserve flash by disabling disk persistence in the stock config (if present).
if [ "$(get mosquitto.persistence)" = persistence ]; then
    set_if_changed mosquitto.persistence.persistence 0
fi
set_if_changed mosquitto.jarbis_local listener
set_if_changed mosquitto.jarbis_local.port 1883
set_if_changed mosquitto.jarbis_local.bind_address 127.0.0.1
set_if_changed mosquitto.jarbis_local.max_connections 16
set_if_changed mosquitto.jarbis_lan listener
set_if_changed mosquitto.jarbis_lan.port 1883
set_if_changed mosquitto.jarbis_lan.bind_address "$lan"
set_if_changed mosquitto.jarbis_lan.max_connections 16
[ "$changed" = 0 ] || "$UCI_BIN" commit mosquitto
if [ "$(get jarbis.broker.managed_ready)" != 1 ]; then
    "$UCI_BIN" set jarbis.broker.managed_ready=1
    "$UCI_BIN" commit jarbis
fi
if [ "$action" = start ]; then
    "$INIT" enable
    "$INIT" restart || fail 'Mosquitto service failed'
fi
