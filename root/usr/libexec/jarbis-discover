#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# On-demand, bounded, read-only discovery; never auto-register or change Tasmota.
set -eu
umask 077
UCI_BIN="${JARBIS_UCI_BIN:-uci}"
HTTP_BIN="${JARBIS_CURL_BIN:-curl}"
SUB_BIN="${JARBIS_MQTT_SUB_BIN:-mosquitto_sub}"
LEASES="${JARBIS_LEASES:-/tmp/dhcp.leases}"
CACHE="${JARBIS_DISCOVERY_CACHE:-/tmp/jarbis-discovery.records}"
CONFIG_DIR="${JARBIS_MQTT_CONFIG_DIR:-/etc/jarbis}"
get() { "$UCI_BIN" -q get "$1" 2>/dev/null || :; }
fail() { printf 'jarbis-discover: %s\n' "$1" >&2; exit 1; }
[ "$#" -eq 1 ] && [ "$1" = scan ] || fail 'usage: jarbis-discover scan'
[ "$(get jarbis.main.enabled)" = 1 ] || fail 'Jarbis disabled'
[ "$(get jarbis.discovery.enabled)" = 1 ] || fail 'discovery disabled'
# Respect dnsmasq's configured lease path (do not scan all LAN addresses).
if [ -z "${JARBIS_LEASES+x}" ]; then
    configured_leases="$(get 'dhcp.@dnsmasq[0].leasefile')"
    [ -z "$configured_leases" ] || LEASES="$configured_leases"
fi
if [ "${JARBIS_TEST_MODE:-}" != 1 ]; then
    case "$LEASES" in /tmp/*) ;; *) fail 'unsafe discovery path' ;; esac
    [ ! -L "$LEASES" ] && [ "$CACHE" = /tmp/jarbis-discovery.records ] || fail 'unsafe discovery path'
fi
# Lock without flock dependency (on-demand RPC calls may overlap).
LOCK="${CACHE}.lock"
mkdir "$LOCK" 2>/dev/null || fail 'scan already running'
TMP="$(mktemp -d /tmp/jarbis-scan.XXXXXX)" || { rmdir "$LOCK"; fail 'temp directory'; }
trap 'rm -rf "$TMP"; rmdir "$LOCK"' EXIT HUP INT TERM
: > "$TMP/results"
# Limit HTTP candidates to the configured /24 LAN. OpenWrt accepts both
# `192.168.1.1/24` and `ipaddr=192.168.1.1` + `netmask=255.255.255.0`.
# A missing dotted netmask is valid ONLY when the address explicitly has /24.
lan="$(get network.lan.ipaddr)"
mask="$(get network.lan.netmask)"
subnet24=0
case "$lan" in
    */24)
        lan="${lan%/24}"
        case "$mask" in ''|255.255.255.0) subnet24=1 ;; esac
        ;;
    */*) : ;;
    *) [ "$mask" = 255.255.255.0 ] && subnet24=1 ;;
esac
prefix=''
if [ "$subnet24" = 1 ]; then
    case "$lan" in
        ''|*[!0-9.]*|.*|*.) : ;;
        *)
            oldifs="$IFS"; IFS=.; set -- $lan; IFS="$oldifs"
            if [ "$#" -eq 4 ]; then
                valid=1
                for octet do
                    [ -n "$octet" ] && [ "$octet" -ge 0 ] 2>/dev/null &&
                        [ "$octet" -le 255 ] 2>/dev/null || valid=0
                done
                [ "$valid" = 1 ] && prefix="${lan%.*}."
            fi
            ;;
    esac
fi
count=0
if [ -n "$prefix" ] && [ -f "$LEASES" ]; then
    # Up to 16 candidate HTTP requests at 1s each, staying inside the 25s RPC budget.
    while read -r expiration mac ip hostname clientid; do
        [ "$count" -lt 16 ] || break
        case "$ip" in "$prefix"*) ;; *) continue ;; esac
        last="${ip#"$prefix"}"
        case "$last" in ''|*[!0-9]*) continue ;; esac
        [ "$last" -ge 1 ] 2>/dev/null && [ "$last" -le 254 ] 2>/dev/null || continue
        count=$((count + 1))
        # Prioritize identified Tasmota DHCP names with a slightly longer
        # timeout while keeping a strict bound across at most 16 candidates.
        timeout=1
        case "$hostname" in
            tasmota-*|Tasmota-*)
                if [ "${tasmota_slow:-0}" -lt 4 ]; then
                    timeout=2
                    tasmota_slow=$((${tasmota_slow:-0} + 1))
                fi
                ;;
        esac
        # Battery Shelly sensors are reachable via HTTP only briefly after
        # waking. Probe known Shelly DHCP hostnames with a read-only RPC,
        # using the same bounded candidate set and timeout budget.
        case "$hostname" in
            ShellyHTG3-*|shellyhtg3-*)
                if "$HTTP_BIN" --disable --fail --silent --show-error --location --max-redirs 0 \
                    --noproxy '*' --proto '=http' --connect-timeout 1 \
                    --max-time 1 --max-filesize 4096 --output "$TMP/shelly" \
                    "http://$ip/rpc/Shelly.GetDeviceInfo" >/dev/null 2>&1; then
                    model="$(jsonfilter -i "$TMP/shelly" -e '@.model' 2>/dev/null || :)"
                    app="$(jsonfilter -i "$TMP/shelly" -e '@.app' 2>/dev/null || :)"
                    gen="$(jsonfilter -i "$TMP/shelly" -e '@.gen' 2>/dev/null || :)"
                    sid="$(jsonfilter -i "$TMP/shelly" -e '@.id' 2>/dev/null || :)"
                    case "$sid" in shellyhtg3-*) ;; *) sid='' ;; esac
                    suffix="${sid#shellyhtg3-}"
                    case "$suffix" in ''|*[!a-fA-F0-9]*) sid='' ;; esac
                    [ "${#suffix}" -eq 12 ] || sid=''
                    mac_hex="$(printf '%s' "$mac" | tr -d ':' | tr A-F a-f)"
                    suffix_lower="$(printf '%s' "$suffix" | tr A-F a-f)"
                    if [ "$model" = S3SN-0U12A ] && [ "$app" = HTG3 ] &&
                        [ "$gen" = 3 ] && [ -n "$sid" ] && [ "$suffix_lower" = "$mac_hex" ]; then
                        printf 'shelly-http|%s|%s|shellyhtg3-%s|Shelly H&T Gen3\n' \
                            "$ip" "$mac" "$suffix_lower" >> "$TMP/results"
                    fi
                fi
                continue
                ;;
        esac
        # No redirects or proxies: a DHCP lease must not cause a second
        # request to a different host. Limit response size before parsing.
        if "$HTTP_BIN" --disable --fail --silent --show-error --location --max-redirs 0 \
            --noproxy '*' --proto '=http' --connect-timeout "$timeout" \
            --max-time "$timeout" --max-filesize 4096 --output "$TMP/http" \
            "http://$ip/cm?cmnd=Status%200" >/dev/null 2>&1; then
            version="$(jsonfilter -i "$TMP/http" -e '@.StatusFWR.Version' 2>/dev/null || :)"
            # Tasmota Status 0 contains the MQTT topic under Status.Topic;
            # do not rely on the firmware version containing 'tasmota'.
            topic="$(jsonfilter -i "$TMP/http" -e '@.Status.Topic' 2>/dev/null || :)"
            name="$(jsonfilter -i "$TMP/http" -e '@.Status.DeviceName' 2>/dev/null || :)"
            [ -n "$version" ] && [ -n "$topic" ] || continue
            case "$topic" in ''|*[!a-zA-Z0-9_-]*|[-_]*) continue ;; esac
            case "$mac" in *[!a-fA-F0-9:]*|'') mac='' ;; esac
            # Data is untrusted. Only safe ASCII is placed in the line protocol.
            name="$(printf '%s' "$name" | tr -cd 'a-zA-Z0-9 _-' | cut -c 1-48)"
            [ -n "$name" ] || name='Tasmota'
            printf 'http|%s|%s|%s|%s\n' "$ip" "$mac" "$topic" "$name" >> "$TMP/results"
        fi
    done < "$LEASES"
fi
host="$(get jarbis.broker.host)"
port="$(get jarbis.broker.port)"
case "$host" in ''|-*|*[!a-zA-Z0-9.:_-]*) host='' ;; esac
case "$port" in ''|*[!0-9]*) port='' ;; esac
# Query retained Tasmota config for up to 2 seconds; no always-on subscriber.
if [ -n "$host" ] && [ -n "$port" ] && [ -f "$CONFIG_DIR/mosquitto_sub" ]; then
    XDG_CONFIG_HOME="$CONFIG_DIR" HOME="$CONFIG_DIR" \
        "$SUB_BIN" -h "$host" -p "$port" -W 2 -v -t 'tasmota/discovery/+/config' 2>/dev/null | head -c 32768 > "$TMP/messages" || :
    seen=0
    while IFS=' ' read -r dest payload; do
        [ "$seen" -lt 24 ] || break
        seen=$((seen + 1))
        case "$dest" in tasmota/discovery/*/config) ;; *) continue ;; esac
        [ "${#payload}" -le 4096 ] || continue
        topic="$(jsonfilter -s "$payload" -e '@.t' 2>/dev/null || :)"
        full="$(jsonfilter -s "$payload" -e '@.ft' 2>/dev/null || :)"
        name="$(jsonfilter -s "$payload" -e '@.dn' 2>/dev/null || :)"
        ip="$(jsonfilter -s "$payload" -e '@.ip' 2>/dev/null || :)"
        mac="$(jsonfilter -s "$payload" -e '@.mac' 2>/dev/null || :)"
        # Only expose supported FullTopic; do not trust arbitrary prefix layouts.
        [ "$full" = '%prefix%/%topic%/' ] || continue
        case "$topic" in ''|*[!a-zA-Z0-9_-]*|[-_]*) continue ;; esac
        if [ -z "$prefix" ]; then ip=''; else
            case "$ip" in "$prefix"*) ;; *) ip='' ;; esac
        fi
        case "$mac" in *[!a-fA-F0-9:]*|'') mac='' ;; esac
        case "$ip" in ''|*[!0-9.]*|.*|*.) ip='' ;; esac
        name="$(printf '%s' "$name" | tr -cd 'a-zA-Z0-9 _-' | cut -c 1-48)"
        [ -n "$name" ] || name='Tasmota'
        printf 'mqtt|%s|%s|%s|%s\n' "$ip" "$mac" "$topic" "$name" >> "$TMP/results"
    done < "$TMP/messages"
fi
# Atomic cache in /tmp only. Does not write flash, auto-add devices or credentials.
mv "$TMP/results" "$CACHE"
